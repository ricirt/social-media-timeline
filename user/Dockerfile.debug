FROM golang:1.21-alpine

# Install build essentials and delve
RUN apk add --no-cache git build-base

WORKDIR /app

# Install delve
RUN go install github.com/go-delve/delve/cmd/dlv@latest

# Copy source code
COPY . .

# Start delve debugger
ENTRYPOINT ["dlv", "debug", \
    "--listen=:40000", \
    "--headless=true", \
    "--api-version=2", \
    "--accept-multiclient", \
    "--continue", \
    "/app/user/cmd/user/main.go"] 